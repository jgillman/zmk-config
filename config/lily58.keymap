/*
 * Joel's Lily58 — HHKB-ish on a split.
 * One Fn, on the left inner thumb. Hold Fn, then also hold Enter (right inner thumb)
 * for the System layer: Bluetooth profiles, BT clear, Studio unlock. Kept off the Fn
 * layer so they can't be hit by accident.
 * Mac-oriented: Opt/Cmd on the thumbs. Anything here can be changed live in ZMK Studio
 * (https://zmk.studio) with the left half plugged in over USB; unlock with Fn+Enter+Tab.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define FN   1
#define SYS  2

/ {
    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp RS(RA(RG(RIGHT_ALT)))>;
            label = "HYPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";

            // | ESC   |  1  |  2  |  3  |  4  |  5  |                 |  6  |  7  |  8  |  9  |  0  |  -    |
            // | TAB   |  Q  |  W  |  E  |  R  |  T  |                 |  Y  |  U  |  I  |  O  |  P  | BSPC  |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |                 |  H  |  J  |  K  |  L  |  ;  |  '    |
            // | SHIFT |  Z  |  X  |  C  |  V  |  B  |  [  |     |  ]  |  N  |  M  |  ,  |  .  |  /  | SHIFT |
            //                   | OPT | CMD | BSPC|  FN   |     | ENTER |SPACE| CMD | OPT |

            bindings = <
&gresc     &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                              &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                               &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                               &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&sk LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B         &kp LBKT    &kp RBKT  &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &sk RSHFT
                           &kp LALT  &kp LGUI  &kp LEFT_ALT  &mo FN      &kp RET   &kp SPACE  &kp RGUI  &hyper
            >;
        };

        fn {
            display-name = "Fn";

            // |   `    | F1  | F2  | F3  | F4  | F5  |                 | F6  | F7  | F8  | F9  | F10 |  =    |
            // |        |     |     |     |     |     |                 | HOME| PGDN| PGUP| END | F11 | DEL   |
            // | CAPS   | VOL-| VOL+| MUTE| PLAY|     |                 |  ←  |  ↓  |  ↑  |  →  | F12 |  \    |
            // |        |     | CUT | COPY|PASTE|     |     |     |     |     |     |     |     |     |       |
            //                   |     |     |     |       |     |  SYS  |     |     |     |

            bindings = <
&kp GRAVE  &kp F1        &kp F2        &kp F3      &kp F4     &kp F5                     &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  &kp EQUAL
&trans     &trans        &trans        &trans      &trans     &trans                     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp F11  &kp DEL
&kp CAPS   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp C_PP   &trans                     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp F12  &kp BSLH
&trans     &trans        &kp LG(X)     &kp LG(C)   &kp LG(V)  &trans  &trans    &trans   &trans    &trans     &trans     &trans     &trans   &trans
                                       &trans      &trans     &trans  &trans    &mo SYS  &trans    &trans     &trans
            >;
        };

        sys {
            display-name = "System";

            // Reached by holding Fn, then Enter.
            // |        |     |     |     |     |     |                 |     |     |     |     |     |       |
            // | STUDIO | BT0 | BT1 | BT2 | BT3 | BT4 |                 |     |     |     |     |     |       |
            // |        |     |     |     |     |     |                 |     |     |     |     |     |       |
            // |        |     |     |     |     |BTCLR|     |     |     |     |     |     |     |     |       |
            //                   |     |     |     |       |     |       |     |     |     |

            bindings = <
&trans          &trans        &trans        &trans        &trans        &trans                          &trans        &trans        &trans            &trans         &trans  &trans
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans        &trans        &trans            &trans         &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans                          &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP_ARROW)  &kp LA(RIGHT)  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &bt BT_CLR    &trans    &trans  &trans        &trans        &trans            &trans         &trans  &trans
                                            &trans        &trans        &trans        &trans    &trans  &trans        &trans        &trans
            >;
        };
    };
};
